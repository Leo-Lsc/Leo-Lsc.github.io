---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
---

<BaseLayout>
  <!-- About -->
  <section id="about" class="mb-16">
    <h2 class="section-heading">About</h2>
    <div class="prose">
      <p>
        Hi! I'm Sicheng Lai, a senior undergrad at the Chinese University of Hong Kong, Shenzhen.
      </p>
      <p>
        I had the pleasure of spending a semester at UC San Diego, where I got to
        work with <a href="https://eydcao.github.io/" target="_blank" rel="noopener">Dr. Yadi Cao</a>
        in <a href="https://roseyu.com/" target="_blank" rel="noopener">Prof. Rose Yu</a>'s
        lab on <strong>SimulCost</strong>, a cost-aware benchmarking framework
        for evaluating LLMs on scientific simulation optimization.
        I'm thrilled that this work — one I'm genuinely proud of — is finally going open-source.
      </p>
      <p>
        At CUHK-Shenzhen, I was fortunate to collaborate with
        <a href="https://bbsngg.github.io/" target="_blank" rel="noopener">Dr. Dingjie Song</a>,
        supervised by
        <a href="https://wabyking.github.io/old.html" target="_blank" rel="noopener">Prof. Benyou Wang</a>,
        on multimodal data contamination detection. We developed <strong>MM-Detect</strong>,
        a systematic framework for detecting data contamination in multimodal LLMs across both text and image modalities.
      </p>
    </div>
  </section>

  <!-- Publications -->
  <section id="publications" class="mb-16">
    <h2 class="section-heading">Publications</h2>
    <div class="flex flex-col gap-4">

      <!-- SimulCost -->
      <div class="publication-card">
        <h3 class="text-base font-semibold text-text-primary mb-1">
          SimulCost: A Cost-Aware Benchmark for Automating Physics Simulations with LLMs
        </h3>
        <p class="text-sm text-text-secondary mb-1">
          Yadi Cao†, <strong class="text-text-primary">Sicheng Lai</strong>†, Jiahe Huang†, Yang Zhang†, Zach Lawrence†, Rohan Bhakta†, Izzy F. Thomas†, Mingyun Cao†, Chung-Hao Tsai, Zihao Zhou, Yidong Zhao, Hao Liu, Alessandro Marinoni, Alexey Arefiev, Rose Yu*
        </p>
        <p class="text-xs text-text-secondary mb-2">† equal contribution &nbsp;·&nbsp; * corresponding author</p>
        <p class="text-sm text-text-secondary italic mb-2">
          arXiv preprint
        </p>
        <p class="text-sm text-text-secondary mb-3">
          <span class="font-medium text-text-primary">TL;DR</span>&nbsp; A cost-aware benchmark for LLM-guided simulation parameter tuning — measuring both accuracy and simulation compute across 12 physics simulators in fluid dynamics, solid mechanics, and plasma physics.
        </p>
        <div class="flex flex-wrap gap-2">
          <a
            href="https://arxiv.org/abs/2603.20253"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-full
                   bg-accent/10 text-accent hover:bg-accent/20
                   transition-colors duration-150"
          >
            Paper
          </a>
          <a
            href="https://github.com/Rose-STL-Lab/SimulCost-Bench"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-full
                   bg-accent/10 text-accent hover:bg-accent/20
                   transition-colors duration-150"
          >
            Code
          </a>
          <a
            href="https://huggingface.co/datasets/Rose-STL-Lab/SimulCost-Bench"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-full
                   bg-accent/10 text-accent hover:bg-accent/20
                   transition-colors duration-150"
          >
            Dataset
          </a>
          <a
            href="https://sichenglai.com/SimulCost-Website/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-full
                   bg-accent/10 text-accent hover:bg-accent/20
                   transition-colors duration-150"
          >
            Website
          </a>
        </div>
      </div>

      <!-- MM-Detect -->
      <div class="publication-card">
        <h3 class="text-base font-semibold text-text-primary mb-1">
          Both Text and Images Leaked! A Systematic Analysis of Data Contamination in Multimodal LLM
        </h3>
        <p class="text-sm text-text-secondary mb-1">
          <strong class="text-text-primary">Sicheng Lai</strong>†, Dingjie Song†, Mingxuan Wang, Shunian Chen, Lichao Sun, Benyou Wang*
        </p>
        <p class="text-xs text-text-secondary mb-2">† equal contribution &nbsp;·&nbsp; * corresponding author</p>
        <p class="text-sm text-text-secondary italic mb-2">
          ICML 2025 DIG-BUGs Workshop (Oral) &nbsp;·&nbsp; EMNLP 2025 (Findings)
        </p>
        <p class="text-sm text-text-secondary mb-3">
          <span class="font-medium text-text-primary">TL;DR</span>&nbsp; A systematic framework for detecting multimodal data contamination in MLLMs, revealing significant contamination — even originating from unimodal pre-training — across 12 models and 5 benchmarks.
        </p>
        <div class="flex flex-wrap gap-2">
          <a
            href="https://arxiv.org/abs/2411.03823"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-full
                   bg-accent/10 text-accent hover:bg-accent/20
                   transition-colors duration-150"
          >
            Paper
          </a>
          <a
            href="https://github.com/MLLM-Data-Contamination/MM-Detect"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-full
                   bg-accent/10 text-accent hover:bg-accent/20
                   transition-colors duration-150"
          >
            Code
          </a>
          <a
            href="https://icml.cc/virtual/2025/51035"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-full
                   bg-accent/10 text-accent hover:bg-accent/20
                   transition-colors duration-150"
          >
            Talk
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Experiences -->
  <section id="experiences" class="mb-16">
    <h2 class="section-heading">Experiences</h2>
    <div class="ml-2">

      <!-- Education -->
      <p class="text-xs font-semibold uppercase tracking-widest text-text-secondary mb-3">Education</p>

      <div class="experience-card">
        <div class="flex items-start justify-between gap-2 mb-1">
          <div>
            <h3 class="text-base font-semibold text-text-primary">B.Sc. Computer Science and Engineering</h3>
            <p class="text-sm text-text-secondary">The Chinese University of Hong Kong, Shenzhen</p>
          </div>
          <p class="text-xs text-text-secondary shrink-0">Sept. 2022 &ndash; June 2026</p>
        </div>
        <ul class="mt-2 space-y-1 list-disc list-inside text-sm text-text-secondary">
          <li>Dean's List (Outstanding academic merit), 2022&ndash;2025</li>
          <li>Undergraduate Research Awards (Key research contributions), 2024&ndash;2025</li>
        </ul>
      </div>

      <div class="experience-card">
        <div class="flex items-start justify-between gap-2 mb-1">
          <div>
            <h3 class="text-base font-semibold text-text-primary">Visiting Student</h3>
            <p class="text-sm text-text-secondary">University of California San Diego</p>
          </div>
          <p class="text-xs text-text-secondary shrink-0">March 2025 &ndash; July 2025</p>
        </div>
      </div>

      <!-- Research Experience -->
      <p class="text-xs font-semibold uppercase tracking-widest text-text-secondary mb-3 mt-8">Research Experience</p>

      <div class="experience-card">
        <div class="flex items-start justify-between gap-2 mb-1">
          <div>
            <h3 class="text-base font-semibold text-text-primary">SimulCost: A Cost-Aware Playground</h3>
            <p class="text-sm text-text-secondary">UC San Diego &mdash; Supervisor: Prof. Rose Yu</p>
          </div>
          <p class="text-xs text-text-secondary shrink-0">April 2025 &ndash; Present</p>
        </div>
        <ul class="mt-2 space-y-1 list-disc list-inside text-sm text-text-secondary">
          <li>Developed SimulCost, a comprehensive benchmarking framework evaluating LLM cost-accuracy trade-off on scientific simulation optimization across 13 physics solvers and 40+ hyperparameter tuning tasks.</li>
          <li>Engineered a scalable Playground API with caching and pandas DataFrame-based persistence, reducing redundant computations by 50%.</li>
          <li>Benchmarked LLMs against brute-force (grid search) and Bayesian optimization (Gaussian process) baselines across 6 real-world scenarios, conducting statistical analysis and ablation studies.</li>
        </ul>
      </div>

      <div class="experience-card">
        <div class="flex items-start justify-between gap-2 mb-1">
          <div>
            <h3 class="text-base font-semibold text-text-primary">Data Contamination in Multimodal LLMs</h3>
            <p class="text-sm text-text-secondary">CUHK-Shenzhen &mdash; Supervisor: Prof. Benyou Wang</p>
          </div>
          <p class="text-xs text-text-secondary shrink-0">June 2024 &ndash; Dec. 2024</p>
        </div>
        <ul class="mt-2 space-y-1 list-disc list-inside text-sm text-text-secondary">
          <li>Pioneered MM-Detect, a systematic multimodal contamination detection framework with two novel methods: Option Order Sensitivity Test and Slot Guessing for Perturbed Caption.</li>
          <li>Validated by training LLaVA-1.5-7B variants with controlled leakage at early, mid, and late training stages across contamination ratios of 10%, 50%, and 100%.</li>
          <li>Developed a heuristic method to trace contamination origins, revealing unimodal contamination in base LLMs and cross-modal contamination via training data overlap analysis.</li>
        </ul>
      </div>

      <!-- Internships -->
      <p class="text-xs font-semibold uppercase tracking-widest text-text-secondary mb-3 mt-8">Internships</p>

      <div class="experience-card">
        <div class="flex items-start justify-between gap-2 mb-1">
          <div>
            <h3 class="text-base font-semibold text-text-primary">Multimodal Algorithm Engineer</h3>
            <p class="text-sm text-text-secondary">Tsinghua Shenzhen International Graduate School, Shenzhen</p>
          </div>
          <p class="text-xs text-text-secondary shrink-0">Dec. 2024 &ndash; March 2025</p>
        </div>
        <ul class="mt-2 space-y-1 list-disc list-inside text-sm text-text-secondary">
          <li>Optimized MLLM configurations through systematic experimentation with LLMs (Qwen2.5/Vicuna) and visual encoders (CLIP/MLCD/SigLIP) based on the LLaVA-Next framework.</li>
          <li>Evaluated model performance using VLMEvalKit and lmms-eval; identified optimal configuration (Qwen2.5 + SigLIP), achieving top 20% ranking on the OpenCompass MLLM Leaderboard.</li>
          <li>Trained Qwen2.5 + SigLIP on agricultural datasets curated and augmented with data-juicer, achieving expert-level agricultural capabilities while maintaining general-domain performance.</li>
        </ul>
      </div>

    </div>
  </section>

  <!-- Teaching -->
  <section id="teaching" class="mb-16">
    <h2 class="section-heading">Teaching</h2>
    <div class="ml-2">
      <div class="experience-card">
        <div class="flex justify-between items-start gap-4">
          <div>
            <h3 class="text-sm font-semibold text-text-primary">
              Undergraduate Student Teaching Fellow
            </h3>
            <p class="text-sm text-text-secondary mt-0.5">
              STA2001: Probability and Statistics I ·
              CUHK-Shenzhen ·
              <a
                href="https://sds.cuhk.edu.cn/en/teacher/265"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-accent transition-colors duration-150"
              >Prof. Tianshi Chen</a>
            </p>
          </div>
          <span class="text-xs text-text-secondary whitespace-nowrap">Spring 2024</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CV -->
  <section id="cv" class="mb-16">
    <h2 class="section-heading">CV</h2>
    <div class="prose mb-6">
      <p>
        My full curriculum vitae is available as a PDF document. You can view it
        inline or download it for your records.
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a
        href={profile.cvPath}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium
               rounded-lg bg-accent text-white hover:bg-accent-hover
               transition-colors duration-150 shadow-sm"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"></path>
          <path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
        </svg>
        View PDF
      </a>
      <a
        href={profile.cvPath}
        download
        class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium
               rounded-lg border border-border text-text-primary
               hover:bg-bg-secondary hover:border-accent/30
               transition-all duration-150"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download
      </a>
    </div>
  </section>

  <!-- Misc -->
  <section id="misc" class="mb-16">
    <h2 class="section-heading">Misc</h2>
    <div class="prose mb-6">
      <p>
        A collection of miscellaneous things I find interesting or worth sharing.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="rounded-xl border border-border bg-surface p-5
                  hover:shadow-md hover:border-accent/30
                  transition-all duration-200">
        <h3 class="text-sm font-semibold text-text-primary mb-3">Hobbies</h3>
        <ul class="text-sm text-text-secondary space-y-1">
          <li>🏋️ Gym — LIGHT WEIGHT BABY!</li>
          <li>🏀 Basketball</li>
          <li>⚽ Soccer</li>
          <li>🎤 Singing (shower concerts mostly, ngl)</li>
          <li>🌄 Traveling — especially when it means chasing breathtaking scenery</li>
        </ul>
      </div>
      <div class="rounded-xl border border-border bg-surface p-5
                  hover:shadow-md hover:border-accent/30
                  transition-all duration-200">
        <h3 class="text-sm font-semibold text-text-primary mb-3">Fun Facts</h3>
        <p class="text-sm text-text-secondary">
          When I’m not coding, you’ll probably find me playing Valorant — maining Raze and Phoenix, and pretending I’m the best Radiant in North America. (Give me some time 🤫)
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
